# Personal Claude Code settings — not shared
.claude/settings.local.json

# Local-only secrets / integration config — never commit
config/

# Local workbench content — the user's own repos live under active/ (in progress)
# and completed/. They are local-only and must never be committed into the public
# core. Keep the .gitkeep placeholders so the dirs stay tracked.
active/*
!active/.gitkeep
completed/*
!completed/.gitkeep

# Note: .claude/commands/ and .claude/skills/ ARE committed — they are the single
# workflow surface the backend loads directly (no separate source-of-truth dir, no
# build step). Only the local settings file above is ignored under .claude/.

# Playwright MCP artifacts (snapshots, console logs, screenshots) — local only
.playwright-mcp/

# Studio run state — pidfiles + logs written by `make up` (the front door)
.run/
